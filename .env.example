# Copy to .env and fill in. Never commit .env.
# The bot refuses to start without TELEGRAM_BOT_TOKEN and ALLOWED_TELEGRAM_USER_IDS.
# Leave a source key blank to skip that source. Leave XAI_API_KEY blank to use the
# rules judge only.

TELEGRAM_BOT_TOKEN=
XAI_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=

# Comma-separated Telegram user ids. Everyone else is ignored.
# Message @userinfobot to learn your numeric id.
ALLOWED_TELEGRAM_USER_IDS=

# Optional.
# DATABASE_PATH=data/checks.db
# XAI_MODEL=grok-4.7
# SOURCE_TIMEOUT_SECONDS=8
# XAI_TIMEOUT_SECONDS=20
